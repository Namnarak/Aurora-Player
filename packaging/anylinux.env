# Paths are expanded by sharun after the AppImage is mounted. Keep the
# Android ABI adapters separate from the host-ABI toolkit libraries.
USE_HOST_XDG_CACHE_HOME=1
GSETTINGS_BACKEND=keyfile
SHARUN_ALLOW_SYS_VKICD=1
AURORA_PORTABLE_MODE=standalone
AURORA_RUNTIME_LIBRARY_DIR=${SHARUN_DIR}/lib/aurora
AURORA_BIN=${SHARUN_DIR}/bin/aurora
AURORA_UPDATE_CANARY_BIN=${SHARUN_DIR}/bin/aurora
AURORA_UPDATE_HELPER=${SHARUN_DIR}/bin/aurora_updater
AURORA_WEBVIEW_HELPER=${SHARUN_DIR}/bin/aurora_webview_helper
AURORA_FAILURE_DIALOG_HELPER=${SHARUN_DIR}/bin/aurora_failure_dialog
AURORA_UPDATE_PROGRESS_HELPER=${SHARUN_DIR}/bin/aurora_failure_dialog
AURORA_FREEBSD_SOCKET_HELPER=${SHARUN_DIR}/share/aurora/helpers/aurora_freebsd_socket_helper
# sharun reloads .env for every child. Publish a default separately so it
# cannot overwrite a candidate-specific manifest supplied by the updater.
AURORA_PACKAGED_COMPATIBILITY_MANIFEST=${SHARUN_DIR}/share/aurora/metadata/roblox_compatibility.json
AURORA_UPDATE_COMPATIBILITY_PATH=${SHARUN_DIR}/share/aurora/metadata/roblox_compatibility.json
AURORA_UPDATE_SIGNING_TRUST_PATH=${SHARUN_DIR}/share/aurora/metadata/roblox_signing_certificates.json
AURORA_UPDATE_HOST_ABI_REFERENCE=${SHARUN_DIR}/share/aurora/metadata/roblox_host_abi_reference.json
AURORA_BOOTSTRAP_SOURCES_PATH=${SHARUN_DIR}/share/aurora/metadata/roblox_bootstrap_sources.json
