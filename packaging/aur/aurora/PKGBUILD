# Maintainer: Namnarak

pkgname=aurora
epoch=1
pkgver=1.0.4
pkgrel=1
pkgdesc='Android x86-64 Roblox compatibility runtime for Linux'
arch=('x86_64')
url='https://github.com/Namnarak/Aurora-Player'
license=('Apache-2.0' 'OFL-1.1')
depends=(
  'capstone'
  'curl'
  'fontconfig'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk4'
  'hicolor-icon-theme'
  'libadwaita'
  'libelf'
  'libglvnd'
  'libplacebo'
  'libpng'
  'libsoup3'
  'libutf8proc'
  'libyaml'
  'minizip'
  'openssl'
  'sdl3>=3.4'
  'sdl3_ttf'
  'vulkan-icd-loader'
  'webkitgtk-6.0'
  'zlib'
)
makedepends=(
  'cmake>=3.20'
  'git'
  'lld'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'vulkan-headers'
)
optdepends=('gamemode: Feral GameMode integration')
conflicts=('aurora-bin' 'aurora-git')
# The original upstream tag predates the source-level FORTIFY/LTO isolation fix.
options=('!debug' '!lto')
source=(
  "aurora::git+https://github.com/Namnarak/Aurora-Player.git#tag=${pkgver}"
)
sha256sums=(
  'SKIP'
)

prepare() {
  cd aurora

  sed -i \
    's|add_subdirectory(third_party/Vulkan-Headers EXCLUDE_FROM_ALL)|find_package(VulkanHeaders CONFIG REQUIRED)|' \
    CMakeLists.txt
}

build() {
  cmake -S aurora -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DAURORA_DEFAULT_COMPATIBILITY_MANIFEST=/usr/share/aurora/metadata/roblox_compatibility.json \
    -DAURORA_DEFAULT_SIGNING_TRUST_MANIFEST=/usr/share/aurora/metadata/roblox_signing_certificates.json \
    -DAURORA_ENABLE_UPSTREAM_JNIVM=OFF \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 aurora/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 aurora/third_party/noto/LICENSES/Noto-Fonts-OFL-1.1.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/third-party/noto/Noto-Fonts-OFL-1.1.txt"
  install -Dm644 aurora/third_party/noto/LICENSES/Noto-CJK-OFL-1.1.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/third-party/noto/Noto-CJK-OFL-1.1.txt"
}
