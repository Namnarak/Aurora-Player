# Maintainer: Namnarak

pkgname=aurora-bin
pkgver=1.0.3
pkgrel=3
pkgdesc='Aurora Player standalone AppImage for Linux (prebuilt)'
arch=('x86_64')
url='https://github.com/Namnarak/Aurora-Player'
license=('Apache-2.0')
depends=('fuse2')
optdepends=('gamemode: Feral GameMode integration')
provides=('aurora')
conflicts=('aurora' 'aurora-git')
options=('!debug' '!strip')

# Release 1.0.3 publishes an AppImage, not a pacman .pkg.tar.zst archive.
# Pin the exact release artifact and its SHA256 rather than referencing a 404.
_appimage='Aurora-x86_64-glibc-standalone.AppImage'
source=(
  "${_appimage}::https://github.com/Namnarak/Aurora-Player/releases/download/${pkgver}/${_appimage}"
  "space.bigrat.aurora.desktop::https://raw.githubusercontent.com/Namnarak/Aurora-Player/${pkgver}/packaging/space.bigrat.aurora.desktop"
  "space.bigrat.aurora.svg::https://raw.githubusercontent.com/Namnarak/Aurora-Player/${pkgver}/packaging/space.bigrat.aurora.svg"
  "LICENSE::https://raw.githubusercontent.com/Namnarak/Aurora-Player/${pkgver}/LICENSE"
)
noextract=("${_appimage}")
sha256sums=(
  '7c005a6c1464feb3e4dbda0429c8f939a67e3ad946ecaffd065debe633e7635b'
  'e274d2cd8246ccc0eed772209178b77295e63eb0895c9e8a0acacae6fc8cee54'
  '016930a068c8ff990ab2a6a934ad99b9a5c239ff4ef0e148c511e0181efac40f'
  '27238097e0d1332c588015a3b724146946a81f2a7b28b3d7a8d44d528ad49d5b'
)

package() {
  install -Dm755 "${srcdir}/${_appimage}" \
    "${pkgdir}/opt/aurora-player/${_appimage}"
  install -Dm644 "${srcdir}/space.bigrat.aurora.desktop" \
    "${pkgdir}/usr/share/applications/space.bigrat.aurora.desktop"
  install -Dm644 "${srcdir}/space.bigrat.aurora.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/space.bigrat.aurora.svg"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/aurora" <<'EOF'
#!/bin/sh
# On systems without working FUSE2, run with APPIMAGE_EXTRACT_AND_RUN=1 aurora.
exec /opt/aurora-player/Aurora-x86_64-glibc-standalone.AppImage "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/aurora"
}
