<component type="desktop-application">
  <id>space.bigrat.aurora</id>
  <name>Aurora Player</name>
  <summary>Play Roblox on Linux with Aurora Player</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <developer id="space.bigrat">
    <name>Aurora Project Authors</name>
  </developer>
  <branding>
    <color type="primary" scheme_preference="light">#CEB3EF</color>
    <color type="primary" scheme_preference="dark">#2F2A6B</color>
  </branding>
  <url type="homepage">https://github.com/Namnarak/Aurora-Player</url>
  <description>
    <p>
      Sign in to Roblox, browse experiences, and play them on Linux.
    </p>
    <p>
      Aurora is an independent community project. It is not affiliated with
      Roblox Corporation or VinegarHQ, and the Roblox client is not included.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Namnarak/Aurora-Player/1.0.3/assets/screenshots/flatpak-home.png</image>
      <caption>Browse Roblox experiences</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Namnarak/Aurora-Player/1.0.3/assets/screenshots/flatpak-gameplay-tower.png</image>
      <caption>Play Tower of Hell on Linux</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/Namnarak/Aurora-Player/1.0.3/assets/screenshots/flatpak-gameplay-lobby.png</image>
      <caption>Play DOORS on Linux</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">space.bigrat.aurora.desktop</launchable>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">moderate</content_attribute>
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="violence-realistic">moderate</content_attribute>
    <content_attribute id="social-chat">moderate</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
    <content_attribute id="social-audio">moderate</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
    <content_attribute id="money-advertising">intense</content_attribute>
    <content_attribute id="money-gambling">moderate</content_attribute>
  </content_rating>
  <provides>
    <binary>aurora</binary>
  </provides>
  <releases>
    <release version="1.0.3" date="2026-10-08">
      <description>
        <ul>
          <li>Aurora Player standalone AppImage for Linux x86_64.</li>
          <li>Native Linux graphics, audio, controller and window integration.</li>
          <li>Managed Roblox payload integrity verification and updater.</li>
          <li>Player MCP control and diagnostics.</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
