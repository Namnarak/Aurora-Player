# Maintainer: Namnarak

pkgname=aurora
pkgver=1.0.4
pkgrel=1
pkgdesc='Android x86-64 Roblox compatibility runtime for Linux'
arch=('x86_64')
url='https://github.com/Namnarak/Aurora-Player'
license=('Apache-2.0' 'OFL-1.1')
depends=(
  'capstone'
  'curl'
  'fontconfig'
  'gtk4'
  'libadwaita'
  'libelf'
  'libglvnd'
  'libplacebo'
  'libpng'
  'libutf8proc'
  'libyaml'
  'minizip'
  'nlohmann-json'
  'openssl'
  'sdl3>=3.4'
  'sdl3_ttf'
  'vulkan-icd-loader'
  'webkitgtk-6.0'
  'zlib'
)
makedepends=(
  'cmake>=3.20'
  'git'
  'lld'
  'ninja'
  'pkgconf'
)
optdepends=('gamemode: Feral GameMode integration')
options=('!debug' 'strip')
source=()
sha256sums=()

_aurora_source_dir="${AURORA_SOURCE_DIR:-${startdir}/../..}"

prepare() {
  [[ -f "${_aurora_source_dir}/CMakeLists.txt" ]] ||
    error 'run makepkg from a complete Aurora checkout'
}

build() {
  cmake -S "${_aurora_source_dir}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DAURORA_DEFAULT_COMPATIBILITY_MANIFEST=/usr/share/aurora/metadata/roblox_compatibility.json \
    -DAURORA_DEFAULT_SIGNING_TRUST_MANIFEST=/usr/share/aurora/metadata/roblox_signing_certificates.json \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${_aurora_source_dir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_aurora_source_dir}/third_party/noto/LICENSES/Noto-Fonts-OFL-1.1.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/third-party/noto/Noto-Fonts-OFL-1.1.txt"
  install -Dm644 "${_aurora_source_dir}/third_party/noto/LICENSES/Noto-CJK-OFL-1.1.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/third-party/noto/Noto-CJK-OFL-1.1.txt"
}
